{
  "name": "threshold",
  "private": true,
  "version": "1.0.0",
  "description": "Threshold: a camera-first mystery game. The web version (GitHub Pages) and the iPhone app (Capacitor, built on EAS) share the same files.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "node scripts/build.mjs && cap sync ios",
    "ios": "node scripts/build.mjs && cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#050404' --iconBackgroundColorDark '#050404' --splashBackgroundColor '#050404' --splashBackgroundColorDark '#050404'"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2"
  }
}
